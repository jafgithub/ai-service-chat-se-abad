# Secrets. Never committed, in either half of the repo.
.env
.env.*
!.env.example
# Except the two build profiles, which carry no secret: they only say where a
# build is served from and where its API is. Without them in the repo a fresh
# clone cannot run `build` or `build:serviceagent` at all.
!frontend/.env.production
!frontend/.env.serviceagent
*.pem

# Python
__pycache__/
*.py[cod]
.venv/
.cache/

# Node and Next
node_modules/
.next/
out/
tsconfig.tsbuildinfo

# Build output
build/web/

# The client's AWS key lives in ~/Downloads and is read from there at run time.
# Nothing under deploy/gpu may ever carry it.
deploy/gpu/*.pem
deploy/gpu/*credential*
deploy/gpu/*accessKey*
