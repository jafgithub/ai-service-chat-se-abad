# ── Copy this file to .env and fill in your values ──────────

# App
DEBUG=false

# MySQL — local instance
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_order
DB_USER=root
DB_PASSWORD=your_mysql_root_password

# OpenAI — used for chat wording AND voice (Whisper speech-to-text + TTS).
OPENAI_API_KEY=sk-...
# Voice models (optional — these are the defaults)
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# SMTP (Gmail example — use an App Password, not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=noreply@smartmarket.com

# Shop notification email (receives new order alerts)
SHOP_EMAIL=sadiq@smartmarket.com
SHOP_NAME=SmartMarket

# Frontend (for CORS)
FRONTEND_URL=http://localhost:3000
